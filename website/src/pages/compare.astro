---
import jetbrainsLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import plexLatin600 from '@fontsource/ibm-plex-mono/files/ibm-plex-mono-latin-600-normal.woff2?url';
import '../styles/themes.css';
import { THEMES } from '../lib/themes';
// The /compare page: bohay vs Herdr (agent multiplexer) and tmux / Zellij
// (traditional multiplexers). Standalone dark page matching the landing look.
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '@fontsource/ibm-plex-mono/700.css';
import Logo from '../assets/logo.svg';

const GITHUB = 'https://github.com/RizRiyz/bohay';
const title = 'Compare bohay vs Herdr, tmux, and Zellij';
const description =
  'How bohay compares to Herdr, tmux, and Zellij for running AI coding agents: live agent status, reboot-proof session resume, a built-in git tab, multi-agent orchestration, and a macOS notch app.';
const ogImage = 'https://bohay.dev/og.png';

// Comparison cells. Each cell is { s: 'yes' | 'part' | 'no', t?: note }.
const yes = { s: 'yes' };
const no = { s: 'no' };
const part = (t) => ({ s: 'part', t });
const ICON = { yes: '✓', part: '◐', no: '–' };

// Columns, left to right: bohay, Herdr, tmux, Zellij.
const GROUPS = [
  {
    name: 'Built for AI coding agents',
    rows: [
      { f: 'Live agent status: blocked, working, done, idle', cells: [yes, yes, no, no] },
      { f: "Reloads the agent's own conversation after a reboot", cells: [yes, part('detach only'), part('detach only'), part('detach only')] },
      { f: 'Silent desktop ping when an agent needs you', cells: [yes, yes, no, no] },
      { f: 'Socket API the agents can drive themselves', cells: [yes, yes, part('scriptable'), part('plugins')] },
    ],
  },
  {
    name: 'Many agents on one repo',
    rows: [
      { f: 'Run several agents at once', cells: [yes, yes, yes, yes] },
      { f: 'Coordination board: task order, file locks, merge after tests pass', cells: [yes, no, no, no] },
      { f: 'Git worktrees as first-class panes', cells: [yes, part('add-on flow'), no, no] },
    ],
  },
  {
    name: 'Git and code',
    rows: [
      { f: 'Built-in git tab: branches, pull requests, issues, commits', cells: [yes, part('diff review'), no, no] },
    ],
  },
  {
    name: 'Interface and reach',
    rows: [
      { f: 'Mouse-native split and resize', cells: [yes, yes, part('needs config'), yes] },
      { f: 'Native macOS notch companion app', cells: [yes, no, no, no] },
      { f: 'Runs in your terminal as a single binary', cells: [yes, yes, yes, yes] },
      { f: 'Panes survive detach and reattach', cells: [yes, yes, yes, yes] },
      { f: 'Remote attach over plain SSH', cells: [yes, yes, yes, yes] },
      { f: 'Extensions or plugins', cells: [yes, yes, part('via TPM'), yes] },
      { f: 'Pick your UI language (8 built in)', cells: [yes, no, no, no] },
    ],
  },
];

const OVER_TMUX = [
  { k: 'Agent-aware', h: 'They cannot see your agents', p: 'tmux and Zellij show panes. bohay shows which agent is blocked, working, done, or idle, and pings you the moment one needs you.' },
  { k: 'Resume', h: 'They forget after a reboot', p: 'A tmux session keeps your shell alive only until the machine restarts. bohay reloads each agent’s actual conversation after a full reboot, with zero setup.' },
  { k: 'Git + teamwork', h: 'No git, no coordination', p: 'bohay adds a git tab, worktrees as panes, and a board that runs several agents on one repo at once without letting them overwrite each other.' },
  { k: 'No config', h: 'Agent-first, mouse-first', p: 'No config file to memorize. Click to split, drag to resize, and the whole interface is built around agents instead of raw shells.' },
];

const OVER_HERDR = [
  { k: 'Notch app', h: 'A native Mac notch app', p: 'Herdr stays in the terminal. bohay mirrors every agent into your Mac’s notch, so you can approve a prompt or jump to an agent without switching windows.' },
  { k: 'Real teamwork', h: 'A team, not just many panes', p: 'File locks so two agents never edit the same file, isolated worktrees, and a merge gate that waits for your tests. Point five agents at one repo and stay safe.' },
  { k: 'Resume', h: 'Reboot-proof resume', p: 'Not just panes that survive a detach. Each agent reloads its own conversation after a full restart, so you can close the laptop and pick up mid-thought tomorrow.' },
  { k: 'Git built in', h: 'Git built in, not bolted on', p: 'A full git tab with pull requests and issues, plus worktrees as first-class panes, so you rarely leave the terminal.' },
];

// Nearby tools, grouped by category. Category-level positioning only, since
// each is a different shape of product (a GUI app, a process runner, a terminal).
const LANDSCAPE = [
  {
    cat: 'Parallel-agent apps',
    tools: 'Conductor · Superset · Emdash',
    what: 'Dedicated tools that fan out several agents across git worktrees so they don’t overwrite each other.',
    fit: 'The same worktree isolation plus a merge-after-tests gate, built right into the terminal you already work in, and it drives any agent, not just one.',
  },
  {
    cat: 'Process managers',
    tools: 'Solo',
    what: 'Start and supervise several long-running processes side by side.',
    fit: 'Agent-aware, not just a process runner: live status, zero-config session resume, and a real terminal for each one.',
  },
  {
    cat: 'AI terminals & runners',
    tools: 'cmux · Warp',
    what: 'A terminal with AI built in, or a lightweight runner for a handful of agent sessions.',
    fit: 'A full multiplexer that coordinates many external agents at once, with live status, reboot-proof resume, a git tab, and a Mac notch app on top.',
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Preload the two faces that are on screen at first paint. Fontsource
         ships `font-display: swap`, so without this every navigation paints in
         the fallback mono and then reflows into the real face — the page-wide
         blink. Preloading lets the font arrive before that first paint, so the
         swap is never seen. Only the latin subsets, and only the weights the
         chrome actually uses. -->
    <link rel="preload" href={jetbrainsLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={plexLatin600} as="font" type="font/woff2" crossorigin />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="canonical" href="https://bohay.dev/compare/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bohay.dev/compare/" />
    <meta property="og:site_name" content="bohay" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <!-- Apply the saved palette *before first paint*. Astro defers normal
         <script> tags, so the picker's own script at the end of <body> only runs
         after the page has already painted in the default palette — which is the
         noir flash you see on every navigation. `is:inline` keeps this as a
         plain blocking script in <head>, so the first paint is already correct.
         Deliberately tiny and dependency-free; it must not delay rendering. -->
    <script is:inline>
      try {
        var t = localStorage.getItem('bohay-theme');
        if (t) document.documentElement.setAttribute('data-bh-theme', t);
      } catch (e) {}
    </script>
  </head>
  <body>
    <nav>
      <div class="nav-inner">
        <a class="brand" href="/">
          <Logo width={34} height={34} class="mark" aria-hidden="true" />
          <span>bohay</span>
        </a>
        <div class="nav-links">
          <a href="/docs/">Docs</a>
          <a href="/modules/">Modules</a>
          <a href="/compare/" aria-current="page">Compare</a>
          <a href="/changelog/">Changelog</a>
  
        <a href={GITHUB} class="gh" aria-label="bohay on GitHub" title="GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"
              ><path
                fill="currentColor"
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path></svg
            >
            </a>
        </div>
      </div>
    </nav>

    <header class="page-hero">
      <div class="glow" aria-hidden="true"></div>
      <span class="eyebrow">Compare</span>
      <h1>bohay vs Herdr, tmux, and Zellij</h1>
      <p>
        Every multiplexer keeps your panes alive. bohay is built to run a whole team of AI coding
        agents: watch them, resume them, and ship their work without leaving the terminal.
      </p>
    </header>

    <section class="table-section">
      <div class="cmp-wrap">
        <table class="cmp">
          <thead>
            <tr>
              <th class="feat"></th>
              <th class="colname c-bohay"><span class="ch"><Logo width={17} height={17} class="mark" aria-hidden="true" /> bohay</span></th>
              <th class="colname">Herdr</th>
              <th class="colname">tmux</th>
              <th class="colname">Zellij</th>
            </tr>
          </thead>
          <tbody>
            {GROUPS.map((g) => (
              <Fragment>
                <tr class="grp"><td colspan="5">{g.name}</td></tr>
                {g.rows.map((row) => (
                  <tr>
                    <th scope="row" class="feat">{row.f}</th>
                    {row.cells.map((c, i) => (
                      <td class={`cell ${c.s}${i === 0 ? ' c-bohay' : ''}`}>
                        <span class="ic">{ICON[c.s]}</span>
                        {c.t && <span class="note">{c.t}</span>}
                      </td>
                    ))}
                  </tr>
                ))}
              </Fragment>
            ))}
          </tbody>
        </table>
      </div>
      <div class="legend">
        <span><b class="yes">✓</b> Yes</span>
        <span><b class="part">◐</b> Partial</span>
        <span><b class="no">–</b> No</span>
        <span class="legend-note">Herdr column reflects its public positioning; features move fast, so treat it as a snapshot.</span>
      </div>
    </section>

    <section class="why">
      <h2>Why bohay over tmux &amp; Zellij</h2>
      <p class="lead">Traditional multiplexers are great at panes. They were never built for agents.</p>
      <div class="wcards">
        {OVER_TMUX.map((c) => (
          <div class="wcard">
            <span class="k">{c.k}</span>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="why alt">
      <h2>Why bohay over Herdr</h2>
      <p class="lead">Same foundation as other agent multiplexers. bohay stacks the coordination, git, and resume layer on top.</p>
      <div class="wcards">
        {OVER_HERDR.map((c) => (
          <div class="wcard">
            <span class="k">{c.k}</span>
            <h3>{c.h}</h3>
            <p>{c.p}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="landscape">
      <h2>The wider landscape</h2>
      <p class="lead">
        A few nearby tools solve part of the same problem from a different angle. Here is where
        bohay fits against each.
      </p>
      <div class="lscards">
        {LANDSCAPE.map((c) => (
          <div class="lcard">
            <div class="lhead">
              <span class="lcat">{c.cat}</span>
              <span class="ltools">{c.tools}</span>
            </div>
            <p>{c.what}</p>
            <p class="lfit"><b>bohay:</b> {c.fit}</p>
          </div>
        ))}
      </div>
      <p class="lnote">
        Each of these is a different shape of tool (a desktop app, a process runner, a terminal).
        bohay's bet is one terminal-native workspace that does the whole loop: run, watch, resume,
        coordinate, and ship.
      </p>
    </section>

    <section class="cta-final">
      <h2>See it for yourself</h2>
      <p class="cta-install">Install in one line: <code>brew install RizRiyz/bohay/bohay</code></p>
      <div class="cta-row">
        <a class="btn primary" href="/docs/">Get started</a>
        <a class="btn" href={GITHUB}>Star on GitHub</a>
      </div>
    </section>

    <footer>
      <div class="foot-inner">
        <div class="foot-brand">
          <Logo width={22} height={22} class="mark" aria-hidden="true" />
          <span>bohay</span>
          <span class="dim">by Riz</span>
        </div>
        <div class="foot-links">
          <a href={GITHUB}>GitHub</a>
          <a href="https://crates.io/crates/bohay">crates.io</a>
        </div>
      </div>
    </footer>

    <!-- Theme picker · floating dock, deliberately outside the nav. A custom
         listbox (not a native select) so it matches the site, opens upward, and
         previews each palette live on hover. -->
    <!-- Brand context menu · right-click the wordmark for the logo assets, the
         way most product sites expose their mark. Plain links + clipboard, no
         dependency. -->
    <div class="brandmenu" id="brandmenu" hidden>
      <a class="bm-item" id="bm-png" href="/brand/bohay-logo.png" download="bohay-logo.png">Download PNG</a>
      <a class="bm-item" id="bm-svg" href="/brand/bohay-logo.svg" download="bohay-logo.svg">Download SVG</a>
      <button type="button" class="bm-item" id="bm-copy" data-src="/brand/bohay-logo.svg">Copy SVG</button>
    </div>
    <div class="theme-dock" id="theme-dock">
      <ul class="td-list" id="td-list" role="listbox" aria-label="Color theme" hidden>
        {THEMES.map((t) => (
          <li>
            <button type="button" class="td-opt" role="option" data-theme={t.id}>
              <i class="td-sw" data-theme={t.id} aria-hidden="true"></i>
              <span class="td-name">{t.label}</span>
            </button>
          </li>
        ))}
      </ul>
      <button type="button" class="td-btn" id="td-btn" aria-expanded="false" aria-haspopup="listbox">
        <i class="td-sw td-sw-cur" aria-hidden="true"></i>
        <span id="td-cur">noir</span>
        <span class="td-caret" aria-hidden="true">▴</span>
      </button>
    </div>
    <script>
    </script>

    <style is:global>
      :root {
        --bg: #070709;
        --bg2: #111116;
        --base: #202028;
        --surface: #1a1a20;
        --line: #25252d;
        --border: #383840;
        --overlay0: #4a4a54;
        --overlay1: #686873;
        --sub: #93939f;
        --sub2: #b6b6c0;
        --text: #e7e7ed;
        --accent: #c6ff1a;
        --sel: #33450e;
        --green: #8fbc7a;
        --mint: #6fc6a3;
        --amber: #e09a4d;
        --coral: #e06c66;
      }
      * { box-sizing: border-box; margin: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg); color: var(--text);
        font: 13.5px/1.75 'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace;
      }
      a { color: inherit; text-decoration: none; }
      h2 { font-size: 1.45rem; letter-spacing: -0.035em; }

      code { font-family: 'JetBrains Mono Variable', ui-monospace, 'SF Mono', Menlo, monospace; }
      h1, h2, h3, .brand, .foot-brand {
        font-family: 'IBM Plex Mono', ui-monospace, 'JetBrains Mono Variable', monospace;
        line-height: 1.14; letter-spacing: -0.045em;
      }
      section, header.page-hero { max-width: 1080px; margin: 0 auto; padding: 4rem 1.5rem; }
      .dim { color: var(--sub); }
      ::selection { background: var(--sel); color: var(--text); }

      /* nav */
      nav {
        position: sticky; top: 0; z-index: 10; background: rgb(from var(--bg) r g b / 0.85);
        border-bottom: 1px solid var(--line);
      }
      .nav-inner {
        display: flex; justify-content: space-between; align-items: center;
        max-width: 1080px; margin: 0 auto; padding: 0.85rem 1.5rem;
      }
      .brand { display: flex; align-items: center; gap: 0.6rem; font-weight: 700; font-size: 1.45rem; letter-spacing: -0.05em; color: var(--text); }
      .mark { display: block; flex-shrink: 0; }
      .nav-links {
        display: flex; align-items: center; gap: 1.4rem; color: var(--sub); font-size: 0.88rem;
        font-family: 'IBM Plex Mono', ui-monospace, monospace; letter-spacing: -0.01em;
      }
      .nav-links a:hover { color: var(--text); }
      .nav-links a[aria-current='page'] { color: var(--accent); }
      .gh {
        display: inline-flex; align-items: center; justify-content: center;
        border: 1px solid var(--line); padding: 0.4rem;
        transition: border-color 0.15s, color 0.15s;
      }
      .gh:hover { border-color: var(--accent); color: var(--accent); }

      /* hero */
      .page-hero { text-align: center; position: relative; padding-top: 4.5rem; }
      .page-hero .glow { display: none;
        position: absolute; inset: -20% 0 auto 0; height: 460px; pointer-events: none;
        background: radial-gradient(ellipse 60% 55% at 50% 0%, rgb(from var(--accent) r g b / 0.09), transparent 70%);
      }
      .eyebrow { font-family: 'IBM Plex Mono', monospace; color: var(--accent); font-size: 0.78rem; letter-spacing: 0.14em; text-transform: uppercase; position: relative; }
      .page-hero h1 { font-size: clamp(1.9rem, 4.6vw, 2.8rem); font-weight: 600; letter-spacing: -0.045em; margin-top: 0.6rem; position: relative; }
      .page-hero p { color: var(--sub); max-width: 46rem; margin: 1.1rem auto 0; font-size: 0.9rem; line-height: 1.8; position: relative; }

      /* comparison table */
      .table-section { padding-top: 1rem; }
      .cmp-wrap { overflow-x: auto; border: 1px solid var(--line);  background: var(--bg2); }
      .cmp { width: 100%; border-collapse: collapse; min-width: 760px; }
      .cmp th, .cmp td { padding: 0.8rem 1rem; text-align: center; border-bottom: 1px solid var(--line); vertical-align: middle; }
      .cmp thead th { position: sticky; top: 0; z-index: 2; background: var(--bg2); font-size: 0.95rem; padding-top: 1rem; padding-bottom: 1rem; }
      .cmp thead .colname { font-family: 'IBM Plex Mono', monospace; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
      .cmp .ch { display: inline-flex; align-items: center; gap: 0.4rem; }
      .cmp .feat { text-align: left; font-family: 'Inter Variable', sans-serif; font-weight: 500; color: var(--text); font-size: 0.9rem; width: 38%; letter-spacing: 0; }
      tbody th.feat { font-weight: 500; }
      .grp td {
        text-align: left; font-family: 'IBM Plex Mono', monospace; font-size: 0.7rem;
        text-transform: uppercase; letter-spacing: 0.12em; color: var(--sub);
        background: var(--bg); padding: 0.55rem 1rem;
      }
      .cmp tbody tr:not(.grp):hover td, .cmp tbody tr:not(.grp):hover th { background: rgb(from var(--text) r g b / 0.04); }
      .cell .ic { font-size: 1.05rem; font-weight: 700; line-height: 1; }
      .cell.yes .ic { color: var(--accent); }
      .cell.part .ic { color: var(--amber); }
      .cell.no .ic { color: var(--overlay0); }
      .cell .note { display: block; font-size: 0.66rem; color: var(--sub); margin-top: 3px; font-family: 'Inter Variable', sans-serif; }
      /* bohay column highlight */
      .c-bohay { background: rgb(from var(--accent) r g b / 0.05); }
      thead th.c-bohay { background: rgb(from var(--accent) r g b / 0.1); border-top: 2px solid var(--accent); color: var(--accent); }
      .cmp tbody tr:not(.grp):hover td.c-bohay { background: rgb(from var(--accent) r g b / 0.09); }

      .legend { display: flex; gap: 1.3rem; justify-content: center; align-items: center; margin-top: 1.1rem; font-size: 0.82rem; color: var(--sub); flex-wrap: wrap; }
      .legend .yes { color: var(--accent); } .legend .part { color: var(--amber); } .legend .no { color: var(--overlay0); }
      .legend-note { font-size: 0.76rem; opacity: 0.75; }

      /* why cards */
      .why { text-align: center; }
      .why h2 { font-size: clamp(1.5rem, 3.4vw, 1.9rem); }
      .why .lead { color: var(--sub); max-width: 42rem; margin: 0.7rem auto 2rem; font-size: 1rem; }
      .wcards { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; text-align: left; }
      .wcard {
        background: none; border: 1px solid var(--line);
         padding: 1.5rem 1.6rem; transition: border-color 0.18s, transform 0.18s;
      }
      .wcard:hover { border-color: rgb(from var(--accent) r g b / 0.42); transform: translateY(-3px); }
      .wcard .k { font-family: 'IBM Plex Mono', monospace; font-size: 0.74rem; color: var(--accent); letter-spacing: 0.02em; }
      .wcard h3 { font-size: 1.08rem; margin: 0.5rem 0 0.55rem; }
      .wcard p { color: var(--sub); font-size: 0.93rem; line-height: 1.62; }

      /* landscape */
      .landscape { text-align: center; }
      .landscape h2 { font-size: clamp(1.5rem, 3.4vw, 1.9rem); }
      .landscape .lead { color: var(--sub); max-width: 44rem; margin: 0.7rem auto 2rem; font-size: 1rem; }
      .lscards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; text-align: left; }
      .lcard {
        background: none; border: 1px solid var(--line);
         padding: 1.4rem 1.5rem; transition: border-color 0.18s;
      }
      .lcard:hover { border-color: rgb(from var(--accent) r g b / 0.32); }
      .lhead { display: flex; flex-direction: column; gap: 0.28rem; margin-bottom: 0.75rem; }
      .lcat { font-family: 'IBM Plex Mono', monospace; font-size: 0.98rem; font-weight: 700; color: var(--text); letter-spacing: -0.02em; }
      .ltools { font-family: 'JetBrains Mono Variable', monospace; font-size: 0.72rem; color: var(--accent); }
      .lcard p { color: var(--sub); font-size: 0.88rem; line-height: 1.58; margin-bottom: 0.6rem; }
      .lcard .lfit { color: var(--text); margin-bottom: 0; }
      .lcard .lfit b { color: var(--accent); font-weight: 600; }
      .lnote { text-align: center; color: var(--sub); max-width: 46rem; margin: 1.9rem auto 0; font-size: 0.92rem; line-height: 1.6; }
      @media (max-width: 860px) { .lscards { grid-template-columns: 1fr; } }

      /* cta */
      .cta-final { text-align: center; }
      .cta-final h2 { font-size: clamp(1.6rem, 3.6vw, 2rem); }
      .cta-install { color: var(--sub); font-size: 0.92rem; margin-top: 0.9rem; }
      .cta-install code { color: var(--accent); background: var(--bg2); border: 1px solid var(--line); padding: 0.2rem 0.55rem;  }
      .btn {
        display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.7rem 1.45rem;
         border: 1px solid var(--line); font-weight: 600; font-size: 0.95rem;
        font-family: 'IBM Plex Mono', monospace; transition: border-color 0.15s, transform 0.15s, filter 0.15s;
      }
      .btn:hover { transform: translateY(-2px); border-color: var(--accent); }
      .btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
      .btn.primary:hover { filter: brightness(1.08); }
      .cta-row { display: flex; gap: 0.8rem; justify-content: center; flex-wrap: wrap; margin-top: 1.4rem; }

      /* footer */
      footer { border-top: 1px solid var(--line); margin-top: 2rem; }
      .foot-inner {
        max-width: 1080px; margin: 0 auto; padding: 2rem 1.5rem;
        display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap;
      }
      .foot-brand { display: flex; align-items: center; gap: 0.5rem; font-weight: 700; }
      .foot-brand .dim { font-weight: 400; font-size: 0.85rem; }
      .foot-links { display: flex; gap: 1.3rem; color: var(--sub); font-size: 0.92rem; }
      .foot-links a:hover { color: var(--accent); }

      @media (max-width: 760px) {
        .wcards { grid-template-columns: 1fr; }
        section, header.page-hero { padding: 3rem 1.25rem; }
      }

      /* Four nav links + the GitHub pill no longer fit a phone in one row:
         let them wrap rather than widen the page. */
      @media (max-width: 560px) {
        .nav-inner { flex-wrap: wrap; row-gap: 0.45rem; padding-top: 0.7rem; padding-bottom: 0.7rem; }
        .nav-links { gap: 0.9rem; font-size: 0.78rem; flex-wrap: wrap; justify-content: flex-end; }
      }

      /* Brand context menu (right-click the wordmark). Same square, hairline
         language as the theme dock. */
      .brandmenu {
        position: fixed; z-index: 60; min-width: 158px; padding: 0.25rem;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .brandmenu[hidden] { display: none; }
      .bm-item {
        display: block; width: 100%; padding: 0.3rem 0.6rem;
        background: none; border: 0; text-align: left; cursor: pointer;
        color: var(--sub); font: inherit; font-size: 0.76rem; white-space: nowrap;
      }
      .bm-item:hover, .bm-item:focus-visible {
        background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none;
      }
      .brand { cursor: pointer; }

      /* Theme picker · floating dock, bottom-right, opening upward. Names only:
         descriptions wrapped and forced scrollbars, and the list is short enough
         to show all palettes at once, so there is nothing to scroll. Hovering a
         name previews that palette on the page immediately. */
      .theme-dock { position: fixed; z-index: 40; right: 1.1rem; bottom: 1.1rem; }
      .td-btn {
        display: inline-flex; align-items: center; gap: 0.5rem;
        padding: 0.42rem 0.7rem; cursor: pointer;
        background: rgb(from var(--bg2) r g b / 0.94);
        border: 1px solid var(--line); color: var(--text);
        font: inherit; font-size: 0.78rem;
        backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
        transition: border-color 0.15s;
      }
      .td-btn:hover, .td-btn[aria-expanded='true'] { border-color: var(--accent); }
      .td-caret { color: var(--sub); font-size: 0.6rem; transition: transform 0.18s; }
      .td-btn[aria-expanded='true'] .td-caret { transform: rotate(180deg); }
      .td-sw {
        width: 9px; height: 9px; flex-shrink: 0; display: block;
        background: var(--accent); border: 1px solid rgb(from var(--text) r g b / 0.25);
      }
      /* Grows upward from the button. No max-height and no overflow, so every
         palette is visible and no scrollbar ever appears. */
      .td-list {
        position: absolute; bottom: calc(100% + 0.4rem); right: 0;
        margin: 0; padding: 0.3rem; list-style: none;
        background: rgb(from var(--bg2) r g b / 0.98);
        border: 1px solid var(--line);
        backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      }
      .td-list[hidden] { display: none; }
      .td-opt {
        display: flex; align-items: center; gap: 0.6rem; width: 100%;
        padding: 0.26rem 0.75rem 0.26rem 0.5rem; cursor: pointer;
        background: none; border: 0; text-align: left;
        color: var(--sub); font: inherit; font-size: 0.78rem;
        white-space: nowrap;
      }
      .td-opt:hover, .td-opt:focus-visible { background: rgb(from var(--accent) r g b / 0.14); color: var(--text); outline: none; }
      .td-opt[aria-selected='true'] { color: var(--accent); }
    </style>

    <script>
      // Theme picker · palettes come from bohay's own registry, generated into
      // styles/themes.css, so what you preview is what the app ships. Applying a
      // theme sets `data-bh-theme` on <html>, which outranks each page's :root.
      //
      // Hovering a name previews it immediately; the choice is only committed on
      // click, so moving away or closing restores what you had.
      (() => {
        const KEY = 'bohay-theme';
        const dock = document.getElementById('theme-dock');
        const btn = document.getElementById('td-btn');
        const list = document.getElementById('td-list');
        const label = document.getElementById('td-cur');
        if (!dock || !btn || !list || !label) return;
        const opts = [...list.querySelectorAll('.td-opt')];
        const root = document.documentElement;

        let committed = localStorage.getItem(KEY) || 'noir';

        // Preview only: paints the page without touching the committed choice.
        const paint = (id) => root.setAttribute('data-bh-theme', id);

        const commit = (id) => {
          committed = id;
          localStorage.setItem(KEY, id);
          paint(id);
          const o = opts.find((x) => x.dataset.theme === id);
          label.textContent = o ? o.querySelector('.td-name').textContent : id;
          opts.forEach((x) => x.setAttribute('aria-selected', String(x.dataset.theme === id)));
        };

        const open = (yes) => {
          list.hidden = !yes;
          btn.setAttribute('aria-expanded', String(yes));
          if (yes) (opts.find((o) => o.getAttribute('aria-selected') === 'true') || opts[0])?.focus();
          else paint(committed); // closing always restores the committed palette
        };


        commit(committed);

        btn.addEventListener('click', () => open(list.hidden));
        opts.forEach((o) => {
          // Live preview on hover and on keyboard focus.
          o.addEventListener('mouseenter', () => paint(o.dataset.theme));
          o.addEventListener('focus', () => paint(o.dataset.theme));
          o.addEventListener('click', () => {
            commit(o.dataset.theme);
            open(false);
            btn.focus();
          });
        });
        // Leaving the list without choosing puts the committed palette back.
        list.addEventListener('mouseleave', () => {
          if (!list.hidden && !list.contains(document.activeElement)) paint(committed);
        });
        document.addEventListener('click', (e) => {
          if (!dock.contains(e.target)) open(false);
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !list.hidden) { open(false); btn.focus(); }
        });
        list.addEventListener('keydown', (e) => {
          const i = opts.indexOf(document.activeElement);
          if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
            e.preventDefault();
            const next = e.key === 'ArrowDown' ? i + 1 : i - 1;
            opts[(next + opts.length) % opts.length].focus();
          }
        });
      })();
    </script>

    <script>
      // Right-click the wordmark for the brand assets. Downloads are plain
      // `download` links; the copy reads the built SVG and writes the markup to
      // the clipboard so it can be pasted straight into a design tool.
      (() => {
        const brand = document.querySelector('.brand');
        const menu = document.getElementById('brandmenu');
        const copy = document.getElementById('bm-copy');
        if (!brand || !menu) return;

        const close = () => { menu.hidden = true; };

        brand.addEventListener('contextmenu', (e) => {
          e.preventDefault();
          menu.hidden = false;
          // Place at the cursor, then nudge back inside the viewport.
          const r = menu.getBoundingClientRect();
          const x = Math.min(e.clientX, window.innerWidth - r.width - 8);
          const y = Math.min(e.clientY, window.innerHeight - r.height - 8);
          menu.style.left = `${Math.max(8, x)}px`;
          menu.style.top = `${Math.max(8, y)}px`;
        });

        copy?.addEventListener('click', async () => {
          const label = copy.textContent;
          try {
            const svg = await fetch(copy.dataset.src).then((r) => r.text());
            await navigator.clipboard.writeText(svg);
            copy.textContent = 'Copied';
          } catch {
            copy.textContent = 'Copy failed';
          }
          setTimeout(() => {
            copy.textContent = label;
            close();
          }, 900);
        });

        // Downloads can close immediately; the browser handles the rest.
        menu.querySelectorAll('a.bm-item').forEach((a) => a.addEventListener('click', close));
        document.addEventListener('click', (e) => { if (!menu.contains(e.target)) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        window.addEventListener('blur', close);
      })();
    </script>
  </body>
</html>
